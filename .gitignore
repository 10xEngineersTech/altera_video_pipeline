# =====================================================================
# Sources that MUST stay in git (never ignored):
#   *.qpf *.qsf *.sdc          Quartus project/settings/timing
#   *.qsys *.ip                Platform Designer system + IP parameterizations
#   rtl/ *.v *.sv *.vhd        Hand-written RTL
#   app/ scripts, *.vh, *.txt  Software / sim configs and inputs
# Everything below is regenerated by Quartus / qsys-generate / ModelSim.
# =====================================================================

# ---- Quartus compile artifacts ----
db/
incremental_db/
qdb/
output_files/
greybox_tmp/
tmp-clearbox/
dni/
ip_upgrade_port_diff_reports/
hps_isw_handoff/
*.qws
*.qarlog
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.pin
*.sld
*.log

# ---- Programming files (rebuilt by a full compile) ----
*.sof
*.pof
*.jic
*.rbf

# ---- Platform Designer (Qsys) generated metadata ----
.qsys_edit/
*.sopcinfo
*.ipxact
*.bsf
*.spd
*.ppf
*.debuginfo
*_inst.v
*_bb.v

# Backup copies Platform Designer drops next to the sources
*.BAK.qsys
*.BAK.ip
*.BAK.v
*.qsys.legacy

# Generated HDL of the integrated system — recreate from pipeline.qsys
# and platform/ip/pipeline/*.ip via "Generate HDL" / qsys-generate.
# (Trailing slash + wildcard ignores only the generated dirs, keeps the .ip files.)
Integrated_design/platform/pipeline/
Integrated_design/platform/ip/pipeline/*/

# ---- Simulation (ModelSim / Questa) ----
transcript
*.wlf
wlft*
work/
libraries/
modelsim.ini
vsim_stacktrace.vstf
simulation/

# ---- Python ----
__pycache__/
*.pyc

# ---- Editor / misc temp files ----
*.bak
*.tmp
*.swp
*.orig
