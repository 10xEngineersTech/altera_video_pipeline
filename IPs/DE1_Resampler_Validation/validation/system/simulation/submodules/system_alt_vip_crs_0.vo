//synopsys translate_off

//synthesis_resources = lut 15 mux21 7 
`timescale 1 ps / 1 ps
module  system_alt_vip_crs_0
	( 
	clock,
	din_data,
	din_endofpacket,
	din_ready,
	din_startofpacket,
	din_valid,
	dout_data,
	dout_endofpacket,
	dout_ready,
	dout_startofpacket,
	dout_valid,
	reset) /* synthesis synthesis_clearbox=1 */;
	input   clock;
	input   [7:0]  din_data;
	input   din_endofpacket;
	output   din_ready;
	input   din_startofpacket;
	input   din_valid;
	output   [7:0]  dout_data;
	output   dout_endofpacket;
	input   dout_ready;
	output   dout_startofpacket;
	output   dout_valid;
	input   reset;

	reg	n00l5;
	reg	n00l6;
	reg	n01O7;
	reg	n01O8;
	reg	n0il3;
	reg	n0il4;
	reg	n0iO1;
	reg	n0iO2;
	reg	niOl;
	wire	wire_niOi_PRN;
	reg	ni1i;
	reg	ni1l;
	reg	ni1O;
	reg	nilO;
	reg	niOO;
	reg	nl1l;
	wire	wire_nl1i_CLRN;
	wire	wire_n0Oi_dataout;
	wire	wire_n0Ol_dataout;
	wire	wire_n0OO_dataout;
	wire	wire_ni0i_dataout;
	wire	wire_niii_dataout;
	wire	wire_niiO_dataout;
	wire	wire_nl1O_dataout;
	wire  n00O;
	wire  n0ii;

	initial
		n00l5 = 0;
	always @ ( posedge clock)
		  n00l5 <= n00l6;
	event n00l5_event;
	initial
		#1 ->n00l5_event;
	always @(n00l5_event)
		n00l5 <= {1{1'b1}};
	initial
		n00l6 = 0;
	always @ ( posedge clock)
		  n00l6 <= n00l5;
	initial
		n01O7 = 0;
	always @ ( posedge clock)
		  n01O7 <= n01O8;
	event n01O7_event;
	initial
		#1 ->n01O7_event;
	always @(n01O7_event)
		n01O7 <= {1{1'b1}};
	initial
		n01O8 = 0;
	always @ ( posedge clock)
		  n01O8 <= n01O7;
	initial
		n0il3 = 0;
	always @ ( posedge clock)
		  n0il3 <= n0il4;
	event n0il3_event;
	initial
		#1 ->n0il3_event;
	always @(n0il3_event)
		n0il3 <= {1{1'b1}};
	initial
		n0il4 = 0;
	always @ ( posedge clock)
		  n0il4 <= n0il3;
	initial
		n0iO1 = 0;
	always @ ( posedge clock)
		  n0iO1 <= n0iO2;
	event n0iO1_event;
	initial
		#1 ->n0iO1_event;
	always @(n0iO1_event)
		n0iO1 <= {1{1'b1}};
	initial
		n0iO2 = 0;
	always @ ( posedge clock)
		  n0iO2 <= n0iO1;
	initial
	begin
		niOl = 0;
	end
	always @ ( posedge clock or  negedge wire_niOi_PRN)
	begin
		if (wire_niOi_PRN == 1'b0) 
		begin
			niOl <= 1;
		end
		else if  (nl1l == 1'b1) 
		begin
			niOl <= n00O;
		end
	end
	assign
		wire_niOi_PRN = ((n00l6 ^ n00l5) & (~ reset));
	event niOl_event;
	initial
		#1 ->niOl_event;
	always @(niOl_event)
		niOl <= 1;
	initial
	begin
		ni1i = 0;
		ni1l = 0;
		ni1O = 0;
		nilO = 0;
		niOO = 0;
		nl1l = 0;
	end
	always @ ( posedge clock or  negedge wire_nl1i_CLRN)
	begin
		if (wire_nl1i_CLRN == 1'b0) 
		begin
			ni1i <= 0;
			ni1l <= 0;
			ni1O <= 0;
			nilO <= 0;
			niOO <= 0;
			nl1l <= 0;
		end
		else 
		begin
			ni1i <= wire_niiO_dataout;
			ni1l <= wire_niii_dataout;
			ni1O <= wire_ni0i_dataout;
			nilO <= wire_n0Oi_dataout;
			niOO <= wire_nl1O_dataout;
			nl1l <= ((dout_ready & niOO) & (n0iO2 ^ n0iO1));
		end
	end
	assign
		wire_nl1i_CLRN = ((n0il4 ^ n0il3) & (~ reset));
	assign		wire_n0Oi_dataout = (nilO === 1'b1) ? wire_n0OO_dataout : wire_n0Ol_dataout;
	assign		wire_n0Ol_dataout = (din_valid === 1'b1) ? (~ ni1l) : (~ ni1O);
	assign		wire_n0OO_dataout = (din_valid === 1'b1) ? (~ ni1i) : (~ ni1l);
	or(wire_ni0i_dataout, ni1O, (din_valid & ((~ ni1O) & ni1l)));
	or(wire_niii_dataout, ni1l, ((din_valid & ((~ ni1l) & ni1i)) & (n01O8 ^ n01O7)));
	or(wire_niiO_dataout, ni1i, (din_valid & (~ ni1i)));
	and(wire_nl1O_dataout, niOO, ~(dout_ready));
	assign
		din_ready = nilO,
		dout_data = {8{1'b0}},
		dout_endofpacket = 1'b0,
		dout_startofpacket = niOl,
		dout_valid = nl1l,
		n00O = 1'b0,
		n0ii = 1'b1;
endmodule //system_alt_vip_crs_0
//synopsys translate_on
//VALID FILE
