`timescale 1ns/10ps

module testbench;
	
	reg clk;
	reg reset;
	
	wire [23:0] out_tdata;
	wire 			out_tvalid;
	wire 			out_tlast;
	wire [2:0]	out_tuser;
	reg 			out_tready;
	
	
	initial clk = 0;
	always #5 clk = ~clk;

	
	initial begin
    reset = 1;
    #50;
    reset = 0;
	end
	
	
	initial begin
    out_tready = 1;
 	end
	
	top dut (
		 .clk(clk),
		 .reset(reset),
		 .m_axis_tdata(out_tdata),
		 .m_axis_tvalid(out_tvalid),
		 .m_axis_tready(out_tready),
		 .m_axis_tlast(out_tlast),
		 .m_axis_tuser(out_tuser));
endmodule