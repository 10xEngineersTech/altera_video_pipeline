FUNCTION altsyncram_psuc1 (address_a[10..0], address_b[10..0], addressstall_b, clock0, clock1, clocken1, data_a[9..0], data_b[9..0], wren_a)
RETURNS ( q_b[9..0]);

--synthesis_resources = M20K 1 
SUBDESIGN altera_syncram_e02n1
( 
	address_a[10..0]	:	input;
	address_b[10..0]	:	input;
	addressstall_b	:	input;
	clock0	:	input;
	clock1	:	input;
	clocken1	:	input;
	data_a[9..0]	:	input;
	data_b[9..0]	:	input;
	q_b[9..0]	:	output;
	wren_a	:	input;
) 
VARIABLE 
	altsyncram1 : altsyncram_psuc1;

BEGIN 
	altsyncram1.address_a[] = address_a[];
	altsyncram1.address_b[] = address_b[];
	altsyncram1.addressstall_b = addressstall_b;
	altsyncram1.clock0 = clock0;
	altsyncram1.clock1 = clock1;
	altsyncram1.clocken1 = clocken1;
	altsyncram1.data_a[] = data_a[];
	altsyncram1.data_b[] = data_b[];
	altsyncram1.wren_a = wren_a;
	q_b[] = altsyncram1.q_b[];
END;
