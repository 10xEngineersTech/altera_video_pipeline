set_global_assignment -name FAMILY "Cyclone 10 GX"
set_global_assignment -name TOP_LEVEL_ENTITY resampling_checker
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:27:56  MARCH 17, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1.1 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name DEVICE 10CX220YF780I5G
set_global_assignment -name IP_FILE ../platform/ip/system/system_clock_in.ip
set_global_assignment -name IP_FILE ../platform/ip/system/system_reset_in.ip
set_global_assignment -name QSYS_FILE ../platform/system.qsys
set_global_assignment -name IP_FILE ../platform/ip/system/system_alt_vip_cl_tpg_0.ip
set_global_assignment -name IP_FILE ../platform/ip/system/system_alt_vip_cl_crs_0.ip
set_global_assignment -name BOARD default
set_global_assignment -name VERILOG_FILE ../rtl/resampling_checker.v
set_location_assignment PIN_L3 -to clk_clk -comment IOBANK_3B
set_location_assignment PIN_L1 -to reset_reset -comment IOBANK_3B
set_location_assignment PIN_N3 -to status_led -comment IOBANK_3B
set_instance_assignment -name IO_STANDARD "1.2-V HSTL CLASS I" -to clk_clk -entity resampling_checker
set_instance_assignment -name IO_STANDARD "1.2-V" -to reset_reset -entity resampling_checker
set_instance_assignment -name IO_STANDARD "1.2-V" -to status_led -entity resampling_checker
