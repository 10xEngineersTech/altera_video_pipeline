# ─────────────────────────────────────────────────────────────
# Quartus build / compile database (regenerated on compile)
# ─────────────────────────────────────────────────────────────
db/
incremental_db/
output_files/
greybox_tmp/
qdb/
dni/
.qsys_edit/
*.done
*.qws

# Reports & logs
*.rpt
*.summary
*.smsg
*.log

# Programming files
*.sof
*.pof
*.jic

# ─────────────────────────────────────────────────────────────
# Simulation output (regenerated every simulation run)
# ─────────────────────────────────────────────────────────────
simulation/
work/
transcript
transcript.*
*.wlf
wlf*
vsim.wlf
vsim_stacktrace.vpd
modelsim.ini
/app/sc_data.txt
# configuration.vh is auto-generated by image_viewer.py
/app/configuration.vh

# Stitched simulation library (rebuilt by setup_sim_libs.sh)
/sim_libs_c10gx/

# ─────────────────────────────────────────────────────────────
# Platform Designer (Qsys) generated HDL
# Keep the .ip / .qsys sources; ignore everything they regenerate.
# ─────────────────────────────────────────────────────────────
/platform/pipeline/
/platform/ip/pipeline/*/
*.sopcinfo
*_inst.v
*_bb.v

# ─────────────────────────────────────────────────────────────
# Backups & temp files
# ─────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.BAK.*
*.qsys.legacy

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
